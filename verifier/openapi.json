{
  "openapi": "3.1.0",
  "info": {
    "title": "TrustRelay Partner API",
    "version": "0.9.0",
    "description": "Institutional verification API for TrustRelay delegated authority. v0.9 adds operational webhooks, notifications, organization RBAC and compliance/audit exports while preserving the v0.8 authority credential format."
  },
  "servers": [
    {
      "url": "https://awrradmcwgeepwwdrbzi.supabase.co/functions/v1/trustrelay-partner-v07"
    }
  ],
  "components": {
    "securitySchemes": {
      "TrustRelayApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-TrustRelay-Key"
      }
    },
    "schemas": {
      "EvaluateRequest": {
        "type": "object",
        "required": [
          "requestId",
          "credential",
          "action",
          "resource"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "maxLength": 160
          },
          "correlationId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "credential": {
            "type": "string",
            "description": "TrustRelay signed authority credential."
          },
          "action": {
            "type": "string",
            "maxLength": 120
          },
          "resource": {
            "type": "string",
            "maxLength": 240
          },
          "amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "currency": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{3}$"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": true
          },
          "evidenceDocumentIds": {
            "type": "array",
            "maxItems": 25,
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "description": "TrustRelay document IDs submitted as verified evidence. Only reviewer-approved documents linked to the evaluated grant are counted."
          }
        }
      },
      "Decision": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "correlationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "ALLOW",
              "DENY",
              "ESCALATE"
            ]
          },
          "reasonCode": {
            "type": "string"
          },
          "reasonDetail": {
            "type": [
              "string",
              "null"
            ]
          },
          "action": {
            "type": "string"
          },
          "resource": {
            "type": "string"
          },
          "grantId": {
            "type": [
              "string",
              "null"
            ]
          },
          "credentialJti": {
            "type": [
              "string",
              "null"
            ]
          },
          "decidedAt": {
            "type": "string"
          },
          "evaluationHash": {
            "type": [
              "string",
              "null"
            ]
          },
          "auditEventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "latencyMs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "api",
              "portal"
            ],
            "description": "Decision source: partner API or authenticated Verifier Portal."
          }
        }
      },
      "EvaluateResponse": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "idempotent": {
            "type": "boolean"
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "rate": {
            "type": "object"
          },
          "organization": {
            "type": "object"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "WebhookEvent": {
        "type": "object",
        "required": [
          "id",
          "type",
          "createdAt",
          "organizationId",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique TrustRelay event ID."
          },
          "type": {
            "type": "string",
            "enum": [
              "decision.created",
              "grant.revoked",
              "credential.revoked",
              "evidence.requested",
              "evidence.submitted",
              "evidence.resolved",
              "organization.member.invited",
              "organization.member.joined",
              "organization.member.role_changed",
              "organization.member.disabled",
              "organization.member.enabled",
              "organization.member.removed",
              "organization.ownership.transferred",
              "compliance.export.ready",
              "webhook.test"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "organizationId": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "security": [],
        "summary": "Partner API health",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        },
        "description": "Returns Partner API health and engine version 0.9.0."
      }
    },
    "/v1/decisions/evaluate": {
      "post": {
        "security": [
          {
            "TrustRelayApiKey": []
          }
        ],
        "summary": "Evaluate delegated authority",
        "description": "Verifies the signed credential, refreshes live assurance/evidence state, evaluates policy, records an auditable v0.9 decision and emits decision.created webhooks.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorization decision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, or revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient scope or inactive organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/decisions/{requestId}": {
      "get": {
        "security": [
          {
            "TrustRelayApiKey": []
          }
        ],
        "summary": "Retrieve a decision by request ID",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stored authorization decision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluateResponse"
                }
              }
            }
          },
          "404": {
            "description": "Decision not found"
          }
        }
      }
    }
  },
  "webhooks": {
    "trustrelayEvent": {
      "post": {
        "summary": "TrustRelay organization event",
        "description": "TrustRelay posts canonical JSON. Verify HMAC-SHA256 over <X-TrustRelay-Timestamp>.<raw request body> using the webhook signing secret. Deliveries are retried with bounded backoff and may enter dead-letter state after exhaustion.",
        "parameters": [
          {
            "name": "X-TrustRelay-Event",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-TrustRelay-Delivery",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-TrustRelay-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-TrustRelay-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^v1=[0-9a-f]{64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Any 2xx response acknowledges delivery."
          },
          "204": {
            "description": "Any 2xx response acknowledges delivery."
          }
        }
      }
    }
  },
  "x-trustrelay-v09": {
    "webhookEvents": [
      "decision.created",
      "grant.revoked",
      "credential.revoked",
      "evidence.requested",
      "evidence.submitted",
      "evidence.resolved",
      "organization.member.invited",
      "organization.member.joined",
      "organization.member.role_changed",
      "organization.member.disabled",
      "organization.member.enabled",
      "organization.member.removed",
      "organization.ownership.transferred",
      "identity.assurance.changed",
      "compliance.export.ready",
      "webhook.test"
    ],
    "organizationRoles": [
      "owner",
      "admin",
      "compliance",
      "verifier",
      "developer",
      "auditor"
    ],
    "complianceExports": [
      "json",
      "csv"
    ],
    "webhookRetry": {
      "defaultMaxAttempts": 5,
      "schedule": [
        "about 1 minute",
        "about 5 minutes",
        "about 30 minutes",
        "about 2 hours",
        "dead-letter after exhaustion"
      ],
      "attemptHistory": true,
      "signing": "HMAC-SHA256 over <timestamp>.<raw body>"
    }
  }
}