{
  "version": 1,
  "policy": "Any Edge Function with verify_jwt=false must be explicitly listed here and retain its independent authentication/public-safety markers.",
  "functions": {
    "trustrelay-credential-verify-v06": {
      "mode": "public-credential-verifier",
      "required": [
        "trustrelay-authority+jwt",
        "consume_rate_limit_v05",
        "VERIFY_GLOBAL_RPM"
      ]
    },
    "trustrelay-jwks-v06": {
      "mode": "public-jwks",
      "required": [
        "loadJwks",
        "JWKS_TTL_MS",
        "etag"
      ]
    },
    "trustrelay-evidence-v08": {
      "mode": "validated-bearer-user",
      "required": [
        "/auth/v1/user",
        "authorization",
        "CANONICAL_APP_ORIGIN"
      ]
    },
    "trustrelay-partner-v07": {
      "mode": "partner-api-key-or-one-time-internal-capability",
      "required": [
        "x-trustrelay-key",
        "p_api_key",
        "p_required_scope",
        "x-trustrelay-internal-capability",
        "trustrelay_consume_portal_capability_v12",
        "bodyHash"
      ]
    },
    "trustrelay-verifier-evaluate-v07": {
      "mode": "validated-bearer-user-plus-service-session-bridge-plus-one-time-capability",
      "required": [
        "/auth/v1/user",
        "authorization",
        "CANONICAL_APP_ORIGIN",
        "trustrelay_portal_session_context_v12",
        "trustrelay_mint_portal_capability_v12",
        "x-trustrelay-internal-capability",
        "bodyHash",
        "randomCapability"
      ]
    },
    "trustrelay-compliance-export-v09": {
      "mode": "validated-bearer-user",
      "required": [
        "/auth/v1/user",
        "authorization",
        "CANONICAL_APP_ORIGIN"
      ]
    },
    "trustrelay-billing-v10": {
      "mode": "bearer-user-or-stripe-webhook",
      "required": [
        "/auth/v1/user",
        "stripe-signature",
        "STRIPE_WEBHOOK_SECRET",
        "trustrelay_sensitive_action_guard_admin_v11"
      ]
    },
    "trustrelay-webhook-egress-v10": {
      "mode": "internal-shared-secret",
      "required": [
        "x-trustrelay-egress-key",
        "timingSafeEqual",
        "expectedInternalSecret"
      ]
    },
    "trustrelay-backup-v10": {
      "mode": "backup-trigger-secret",
      "required": [
        "x-trustrelay-backup-token",
        "validateTrigger",
        "trustrelay_validate_backup_trigger_v10"
      ]
    },
    "trustrelay-backup-sink-v10": {
      "mode": "signed-backup-source",
      "required": [
        "x-trustrelay-signature",
        "x-trustrelay-kid",
        "x-trustrelay-ts"
      ]
    },
    "trustrelay-sso-v13": {
      "mode": "rate-limited-public-discovery-or-validated-bearer-admin",
      "required": [
        "/auth/v1/user",
        "authorization",
        "CANONICAL_APP_ORIGIN",
        "consume_rate_limit_v05",
        "trustrelay_sso_discover_v13",
        "trustrelay_store_sso_provider_v13",
        "trustrelay_set_sso_domain_challenge_v13",
        "trustrelay_mark_sso_domain_verified_v13",
        "cloudflare-dns.com",
        "SAML_PLAN_UPGRADE_REQUIRED"
      ]
    },
    "trustrelay-scim-v14": {
      "mode": "organization-scoped-scim-bearer",
      "required": [
        "authorization",
        "tr_scim_secret_",
        "sha256Hex",
        "trustrelay_scim_resolve_bearer_v14",
        "application/scim+json",
        "ServiceProviderConfig",
        "urn:ietf:params:scim:schemas:core:2.0:User",
        "SCIM_RATE_LIMITED"
      ]
    }
  }
}
